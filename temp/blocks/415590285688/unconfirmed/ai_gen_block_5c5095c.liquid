{% doc %}
  @prompt
    Add a visual divider banner section within the Honey and Beeswax Soaps and Lip Balms collection page that separates soap products from lip balm products. The banner should display a heading such as "Lip Balms" to clearly signal the start of a new product category within the collection grid. It should match the store's existing style — clean, premium, and minimal.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-divider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-divider__inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-divider__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-category-divider__subheading-{{ ai_gen_id }} {
    margin: {{ block.settings.subheading_spacing }}px 0 0;
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    opacity: {{ block.settings.subheading_opacity }};
  }

  .ai-category-divider__line-{{ ai_gen_id }} {
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    opacity: {{ block.settings.line_opacity }};
    margin: {{ block.settings.line_spacing }}px auto 0;
    max-width: {{ block.settings.line_width }}%;
  }

  {% if block.settings.show_line_before %}
    .ai-category-divider__line-before-{{ ai_gen_id }} {
      height: {{ block.settings.line_thickness }}px;
      background-color: {{ block.settings.line_color }};
      opacity: {{ block.settings.line_opacity }};
      margin: 0 auto {{ block.settings.line_spacing }}px;
      max-width: {{ block.settings.line_width }}%;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-category-divider-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 | round }}px 0 {{ block.settings.padding_bottom | times: 0.7 | round }}px;
    }

    .ai-category-divider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 | round }}px;
    }

    .ai-category-divider__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-category-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-divider__inner-{{ ai_gen_id }}">
    {% if block.settings.show_line_before %}
      <div class="ai-category-divider__line-before-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-category-divider__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-category-divider__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.show_line_after %}
      <div class="ai-category-divider__line-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</div>

